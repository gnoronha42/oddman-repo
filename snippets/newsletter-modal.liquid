{%- doc -%}
  Newsletter modal (Oddman) - opens on page load (configured via settings) and uses theme dialog-component.
{%- enddoc -%}

{%- if settings.enable_newsletter_modal -%}
  {%- liquid
    assign disable_auto_open = false
    if request.design_mode
      assign disable_auto_open = true
    endif
    unless auto_open
      assign disable_auto_open = true
    endunless
  -%}
  <script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
  <script src="{{ 'newsletter-modal.js' | asset_url }}" type="module"></script>

  <dialog-component
    id="newsletter-modal"
    class="newsletter-modal"
    data-frequency="{{ settings.newsletter_modal_frequency | default: 'once_per_visitor' }}"
    {% if disable_auto_open %}
      data-disable-auto-open="true"
    {% endif %}
  >
    <dialog
      ref="dialog"
      on:click="/closeDialogOnClickOutside"
      on:keydown="/closeDialogOnEscapePress"
      class="newsletter-modal__dialog dialog-modal"
      scroll-lock
      aria-label="Newsletter"
    >
      <button
        ref="closeButton"
        on:click="/closeDialog"
        class="button button-unstyled newsletter-modal__close"
        aria-label="Close"
      >
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      <div class="newsletter-modal__grid">
        <div class="newsletter-modal__left">
          {%- if settings.newsletter_modal_image != blank -%}
            <img
              src="{{ settings.newsletter_modal_image | image_url: width: 1400 }}"
              alt=""
              loading="eager"
              class="newsletter-modal__image"
            >
          {%- else -%}
            <img
              src="{{ 'jesus.png' | asset_url }}"
              alt="{{ shop.name }}"
              loading="eager"
              class="newsletter-modal__image newsletter-modal__image--default"
            >
          {%- endif -%}
        </div>

        <div class="newsletter-modal__right">
          <div class="newsletter-modal__content">
            <div class="newsletter-modal__logo">
              {%- if settings.newsletter_modal_logo_image != blank -%}
                <img
                  src="{{ settings.newsletter_modal_logo_image | image_url: width: 300 }}"
                  alt="{{ shop.name }}"
                  class="newsletter-modal__logo-img"
                >
              {%- else -%}
                <img
                  src="{{ 'newsletter-logo-oddman.png' | asset_url }}"
                  alt="{{ shop.name }}"
                  class="newsletter-modal__logo-img newsletter-modal__logo-img--default"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                >
                <span class="newsletter-modal__logo-text" style="display:none;">
                  {{- settings.newsletter_modal_logo_text | default: shop.name -}}
                </span>
              {%- endif -%}
            </div>

            <div class="newsletter-modal__headline">
              {{ settings.newsletter_modal_headline | default: "JOIN THE KULT" }}
            </div>

            <div class="newsletter-modal__subheadline">
              {{ settings.newsletter_modal_subheadline | default: "UNLOCK EXCLUSIVE DEALS WITH ACCESS TO 1/1 CUSTOMS AND MEMBER-ONLY DISCOUNTS." }}
            </div>

            {%- form 'customer', id: 'NewsletterModalForm', class: 'newsletter-modal__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">

              <label class="visually-hidden" for="NewsletterModalEmail">Email</label>
              <input
                id="NewsletterModalEmail"
                type="email"
                name="contact[email]"
                class="newsletter-modal__input"
                value=""
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ settings.newsletter_modal_placeholder | default: 'Email' }}"
                required
              >

              <button type="submit" class="newsletter-modal__submit">
                {{ settings.newsletter_modal_button_label | default: "Subscribe" }}
              </button>

              <div class="newsletter-modal__privacy">
                {%- assign privacy_url = settings.newsletter_modal_privacy_url | default: '/pages/privacy-policy' -%}
                {%- assign privacy_text = settings.newsletter_modal_privacy_text
                  | default: 'You may unsubscribe at any time. To find out more, please visit our Privacy Policy.'
                -%}

                {{ privacy_text | replace: 'Privacy Policy', '<a href="' | append: privacy_url | append: '" class="newsletter-modal__privacy-link">Privacy Policy</a>' }}
              </div>
            {%- endform -%}
          </div>
        </div>
      </div>
    </dialog>
  </dialog-component>
{%- endif -%}

{% stylesheet %}
  .newsletter-modal__dialog {
    --backdrop-opacity: 0.6;
    --backdrop-color-rgb: 0 0 0;
    padding: 0;
    width: min(1100px, 92vw);
    max-width: 1100px;
    margin: auto;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    overflow: hidden;
    background: #000;
    border-radius: 0;
    border: 1px solid rgba(255, 0, 0, 0.3);
  }

  .dialog-modal[open].newsletter-modal__dialog {
    border-radius: 0;
    box-shadow: var(--shadow-popover);
    transform: translate(-50%, -50%);
  }

  .newsletter-modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: #ff0000;
    background: transparent;
    z-index: 3;
  }

  .newsletter-modal__close .svg-wrapper {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .newsletter-modal__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
  }

  .newsletter-modal__left {
    position: relative;
    background: #111;
  }

  .newsletter-modal__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .newsletter-modal__image--default {
    object-fit: cover;
    padding: 0;
    background: #000;
  }

  .newsletter-modal__placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 30% 30%, #1a1a1a, #000);
  }

  .newsletter-modal__right {
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 42px;
  }

  .newsletter-modal__content {
    width: 100%;
    max-width: 420px;
    text-align: center;
    color: #ff0000;
  }

  .newsletter-modal__logo {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .newsletter-modal__logo-img {
    width: 156px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .newsletter-modal__logo-text {
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 42px;
    line-height: 1;
    color: #ff0000;
  }

  .newsletter-modal__headline {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 15px;
    margin-bottom: 10px;
  }

  .newsletter-modal__subheadline {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 15px;
    line-height: 1.25;
    margin-bottom: 22px;
  }

  .newsletter-modal__form {
    display: grid;
    gap: 14px;
    justify-items: stretch;
  }

  .newsletter-modal__input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    background: #000;
    border: 2px solid #ff0000;
    color: #ff0000;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    outline: none;
  }

  .newsletter-modal__input::placeholder {
    color: rgba(255, 0, 0, 0.75);
  }

  .newsletter-modal__submit {
    width: 100%;
    height: 46px;
    background: #ff0000;
    color: #000;
    border: 2px solid #ff0000;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    cursor: pointer;
  }

  .newsletter-modal__privacy {
    font-size: 10px;
    line-height: 1.35;
    color: rgba(255, 0, 0, 0.9);
    margin-top: 6px;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .newsletter-modal__privacy a {
    color: #ff0000;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .newsletter-modal__dialog {
      width: 82vw !important;
      max-width: 360px !important;
      height: fit-content;
      max-height: 68vh;
      overflow-y: auto;
      border: 1px solid rgba(255, 0, 0, 0.5);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
    }

    /* No mobile: apenas a coluna do formulário — esconde a imagem lateral */
    .newsletter-modal__grid {
      grid-template-columns: 1fr;
      min-height: 0;
      align-items: start;
    }

    .newsletter-modal__left {
      display: none;
    }

    .newsletter-modal__right {
      padding: 20px 16px 14px;
      min-height: auto;
    }

    .newsletter-modal__logo-img {
      width: 120px;
    }

    .newsletter-modal__logo-text {
      font-size: 26px;
    }

    .newsletter-modal__headline {
      font-size: 11px;
      margin-bottom: 6px;
    }

    .newsletter-modal__subheadline {
      font-size: 10px;
      margin-bottom: 14px;
      line-height: 1.3;
    }

    .newsletter-modal__form {
      gap: 10px;
    }

    .newsletter-modal__input,
    .newsletter-modal__submit {
      height: 40px;
      font-size: 0.8rem;
      padding: 0 12px;
    }

    .newsletter-modal__privacy {
      font-size: 9px;
      margin-top: 6px;
      line-height: 1.35;
    }

    .newsletter-modal__close {
      top: 8px;
      right: 8px;
      width: 30px;
      height: 30px;
    }

    .newsletter-modal__close .svg-wrapper {
      width: 14px;
      height: 14px;
    }
  }
{% endstylesheet %}
