{% doc %}
  @prompt
    Gere um section com um botão centralizado 
    
    Request 1/1 Custom
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-centered-button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-centered-button-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
  }

  .ai-centered-button-link-{{ ai_gen_id }} {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {% if block.settings.button_text_uppercase %}uppercase{% else %}none{% endif %};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-centered-button-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-centered-button-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 20px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-centered-button-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-centered-button-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-centered-button-container-{{ ai_gen_id }}">
    <a href="{{ block.settings.button_link }}" class="ai-centered-button-link-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Botão centralizado",
  "settings": [
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "Clique aqui"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Tamanho da fonte",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Peso da fonte",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Médio"
        },
        {
          "value": "600",
          "label": "Semi-negrito"
        },
        {
          "value": "700",
          "label": "Negrito"
        }
      ],
      "default": "500"
    },
    {
      "type": "checkbox",
      "id": "button_text_uppercase",
      "label": "Texto em maiúsculas",
      "default": false
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Padding vertical",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Padding horizontal",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Raio da borda",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Largura da borda",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Fundo do botão",
      "default": "#030302"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto do botão",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Borda do botão",
      "default": "#030302"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Fundo do botão (hover)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Texto do botão (hover)",
      "default": "#030302"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Borda do botão (hover)",
      "default": "#030302"
    },
    {
      "type": "header",
      "content": "Seção"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Botão centralizado"
    }
  ],
  "tag": null
}
{% endschema %}
