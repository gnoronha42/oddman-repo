<!-- 
  FOOTER TEMPLATE PARA SHOPIFY - ODDMAN
  Use este template no seu tema Shopify
-->

<div class="section-background color-scheme-1"></div>
<div class="section color-scheme-1" style="width: 100%; max-width: 100%; padding: 0; margin: 0;">
  <div class="spacing-style layout-panel-flex layout-panel-flex--column section-content-wrapper" style="width: 100%; max-width: 100%;">
    
    <footer class="footer">
      <div class="footer__content-top">
        
        <!-- Grid principal dos blocos - incluindo newsletter -->
        <div class="footer__blocks-wrapper">
          
          <!-- Bloco 1: Customer Care -->
          <div class="footer-block footer-block--menu">
            <h2 class="footer-block__heading">Customer Care</h2>
            <ul class="footer-block__details-content list-unstyled">
              <li>
                <a href="/pages/faqs" class="link link--text list-menu__item list-menu__item--link">
                  FAQs
                </a>
              </li>
              <li>
                <a href="/pages/contact" class="link link--text list-menu__item list-menu__item--link">
                  Contact Us
                </a>
              </li>
            </ul>
          </div>
          
          <!-- Bloco 2: Legal -->
          <div class="footer-block footer-block--menu">
            <h2 class="footer-block__heading">Legal</h2>
            <ul class="footer-block__details-content list-unstyled">
              <li>
                <a href="/pages/terms" class="link link--text list-menu__item list-menu__item--link">
                  Terms & Conditions
                </a>
              </li>
              <li>
                <a href="/pages/privacy-policy" class="link link--text list-menu__item list-menu__item--link">
                  Privacy Policy
                </a>
              </li>
              <li>
                <a href="/pages/cookies-policy" class="link link--text list-menu__item list-menu__item--link">
                  Cookies Policy
                </a>
              </li>
            </ul>
          </div>
          
          <!-- Bloco 3: Stockists -->
     
          
          <!-- Bloco 4: Follow Us -->
          <div class="footer-block">
            <h2 class="footer-block__heading">Follow</h2>
            <div class="footer-block__details-content rte">
              <p>
                <a href="https://www.instagram.com/oddman_official/" 
                   target="_blank" 
                   class="link link--text"
                   title="INSTAGRAM">
                  INSTAGRAM
                </a>
              </p>
              <p>
                <a href="https://www.facebook.com/oddman" 
                   target="_blank" 
                   class="link link--text"
                   title="FACEBOOK">
                  FACEBOOK
                </a>
              </p>
            </div>
          </div>
          
          <!-- Bloco 5: Newsletter - agora na mesma linha -->
          <div class="footer-block footer-block--newsletter-inline">
            <form method="post" 
                  action="/contact#ContactFooter" 
                  id="ContactFooter" 
                  accept-charset="UTF-8" 
                  class="footer__newsletter newsletter-form">
              
              <input type="hidden" name="form_type" value="customer">
              <input type="hidden" name="utf8" value="✓">
              <input type="hidden" name="contact[tags]" value="newsletter">
              
              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input id="NewsletterForm--footer" 
                         type="email" 
                         name="contact[email]" 
                         class="field__input" 
                         value="" 
                         aria-required="true" 
                         autocorrect="off" 
                         autocapitalize="off" 
                         autocomplete="email" 
                         placeholder="Email" 
                         required="">
                  <button type="submit" 
                          class="newsletter-form__button field__button" 
                          name="commit" 
                          id="Subscribe" 
                          aria-label="Subscribe">
                    Subscribe
                  </button>
                </div>
              </div>
              
              <span class="form--text">
                You may unsubscribe at any time. To find out more, please visit our 
                <a class="privacyLink" href="/pages/privacy-policy">Privacy Policy</a>.
              </span>
            </form>
          </div>
          
        </div>
        
      </div>
      
      <!-- Footer Bottom -->
      <div class="footer__content-bottom">
        <div class="footer__content-bottom-wrapper">
          <div class="footer__column footer__localization isolate"></div>
          <div class="footer__column footer__column--info">
            <p class="footer__copyright">
              © {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
            </p>
          </div>
        </div>
      </div>
      
    </footer>
  </div>
</div>

<!-- Adicione este CSS no final do arquivo ou no theme.liquid -->
<style>
/* ========================================
   FOOTER CUSTOM STYLES - ODDMAN
   ======================================== */

/* Container principal do footer */
.footer {
  /* Breakout technique para ocupar 100% da tela ignorando containers pai */
  width: 100vw !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  
  background: #000000 !important;
  padding: 3rem 0 2rem !important;
  
  display: flex;
  flex-direction: column;
  align-items: stretch; /* Mudado de center para stretch para ocupar toda largura */
  
  /* Garantir que não há overflow */
  overflow-x: hidden !important;
  box-sizing: border-box !important;
}

.footer__content-top,
.footer__content-bottom {
  width: 100% !important;
  max-width: none !important; /* Remove qualquer limitação de largura */
  margin: 0 !important;
  padding: 0 20px !important; /* Padding mínimo apenas para não colar na borda */
  box-sizing: border-box;
}

/* Grid responsivo para os blocos - layout horizontal com 5 colunas */
.footer__blocks-wrapper {
  display: grid;
  /* auto-fit evita "coluna fantasma" quando há menos blocos no HTML */
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 0.5rem; /* Gap mínimo */
  margin-bottom: 2rem;
  align-items: start;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* Alinhamento dos blocos para "ponta a ponta" */
.footer-block {
    width: 100%;
    text-align: center; /* Padrão centralizado */
}

/* Primeiro bloco alinhado à esquerda */
.footer-block:first-child,
.footer-block:first-child .footer-block__heading,
.footer-block:first-child .footer-block__details-content,
.footer-block:first-child ul,
.footer-block:first-child p,
.footer-block:first-child a {
    text-align: left;
    align-items: flex-start;
}

/* Último bloco alinhado à direita */
.footer-block:last-child,
.footer-block:last-child .footer-block__heading,
.footer-block:last-child .footer-block__details-content,
.footer-block:last-child p,
.footer-block:last-child form,
.footer-block:last-child .newsletter-form__field-wrapper {
    text-align: right;
    align-items: flex-end;
    margin-left: auto;
}

/* Ajuste específico para o formulário na direita */
.footer-block:last-child .newsletter-form__field-wrapper {
    align-items: flex-end; /* Alinha input/botão à direita se estiverem em coluna */
}

/* Ajuste para mobile */
@media (max-width: 768px) {
  .footer__content-top,
  .footer__content-bottom {
      padding: 0 20px;
  }
  
  /* No mobile, volta tudo para o centro */
  .footer-block:first-child,
  .footer-block:last-child,
  .footer-block:first-child *,
  .footer-block:last-child * {
      text-align: center;
      align-items: center;
      margin-left: 0;
  }
}

.footer-block {
    width: 100%; /* Garante que o bloco ocupe sua área */
}

/* Responsividade */
@media (max-width: 1200px) {
  .footer__blocks-wrapper {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
}

@media (max-width: 1024px) {
  .footer__blocks-wrapper {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
}

@media (max-width: 768px) {
  .footer__blocks-wrapper {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .footer {
    padding: 2rem 0 1.5rem;
  }

  .newsletter-form__field-wrapper {
    gap: 0.5rem;
  }
}

/* Estilo dos blocos individuais */
.footer-block {
  text-align: center;
}

.footer-block__heading {
  font-size: 1.1rem;
  font-weight: 600;
  color: #ff0000;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: none;
  padding-bottom: 0.5rem;
  display: block;
  font-family: 'Arial', sans-serif;
  text-align: center;
}

/* Conteúdo dos blocos centralizado */
.footer-block__details-content {
  text-align: center;
}

.footer-block__details-content ul {
  text-align: center;
  display: inline-block;
}

/* Links dos menus */
.footer-block__details-content .link {
  color: #ff0000;
  text-decoration: none;
  font-size: 0.95rem;
  transition: color 0.3s ease;
  display: block;
  margin-bottom: 0.5rem;
  font-family: 'Arial', sans-serif;
  font-weight: 400;
  text-align: center;
}

.footer-block__details-content .link:hover {
  color: #ff3333;
  text-decoration: underline;
}

/* Lista de links */
.footer-block__details-content ul {
  list-style: none;
  padding: 0;
  margin: 0;
  text-align: center;
  display: inline-block;
}

.footer-block__details-content li {
  margin-bottom: 0.4rem;
  text-align: center;
}

/* Conteúdo dos blocos com texto (Stockists, Follow) */
.footer-block__details-content p {
  text-align: center;
  margin-bottom: 0.5rem;
}

.footer-block__details-content p a {
  text-align: center;
}

/* Newsletter inline - na mesma linha dos outros blocos */
.footer-block--newsletter-inline {
  text-align: center;
}

.footer-block--newsletter-inline .footer-block__heading {
  font-size: 1.1rem;
  color: #ff0000;
  border-bottom: none;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 1rem;
  font-family: 'Arial', sans-serif;
  font-weight: 600;
}

/* Formulário de newsletter */
.newsletter-form {
  margin-bottom: 1rem;
}

.newsletter-form__field-wrapper {
  display: flex;
  flex-direction: column;
  max-width: none;
  margin: 0 0 0.5rem 0;
  border-radius: 0;
  overflow: hidden;
  box-shadow: none;
  gap: 0.5rem;
}

.field__input {
  flex: 1;
  padding: 0.75rem 1rem;
  border: 1px solid #ff0000 !important;
  outline: none !important;
  font-size: 0.95rem;
  background: #000000 !important;
  color: #ff0000 !important;
  font-family: 'Arial', sans-serif;
  box-shadow: none !important;
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
  appearance: none !important;
}

.field__input::placeholder {
  color: #ff6666;
}

.field__button {
  background: #ff0000;
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.3s ease;
  font-family: 'Arial', sans-serif;
}

.field__button:hover {
  background: #ff3333;
}

/* Texto do formulário */
.form--text {
  font-size: 0.65rem;
  color: #ff0000;
  line-height: 1.3;
  font-family: 'Arial', sans-serif;
  text-transform: uppercase;
  display: block;
  max-width: 100%;
}

.form--text .privacyLink {
  color: #ff0000;
  text-decoration: none;
}

.form--text .privacyLink:hover {
  text-decoration: underline;
}

/* Footer bottom */
.footer__content-bottom {
  border-top: none;
  padding-top: 1.5rem;
  text-align: center;
  color: #ff0000;
}

/* Ajustes específicos para mobile */
@media (max-width: 480px) {
  .footer-block__heading {
    font-size: 1rem;
  }
  
  .newsletter-form__field-wrapper {
    flex-direction: column;
    border-radius: 10px;
  }
  
  .field__button {
    border-radius: 0 0 10px 10px;
  }
  
  .field__input {
    border-radius: 10px 10px 0 0;
  }
}

/* Animações suaves */
.footer-block {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease forwards;
}

.footer-block:nth-child(1) { animation-delay: 0.1s; }
.footer-block:nth-child(2) { animation-delay: 0.2s; }
.footer-block:nth-child(3) { animation-delay: 0.3s; }
.footer-block:nth-child(4) { animation-delay: 0.4s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Melhorias de acessibilidade */
.footer-block__heading:focus {
  outline: 2px solid #3498db;
  outline-offset: 2px;
}

.field__input:focus {
  outline: none !important;
  border: 1px solid #ff0000 !important;
  box-shadow: none !important;
}

.field__button:focus {
  outline: 2px solid #ff0000;
  outline-offset: 2px;
}

/* Estilo consistente - sempre preto e vermelho */
.footer {
  background: #000000 !important;
}

/* Remover bordas brancas específicas */
.footer,
.footer__content-top,
.footer__content-bottom {
  border: none !important;
  outline: none !important;
}

.footer-block__heading,
.footer-block__details-content .link,
.footer-block__details-content p,
.footer-block__details-content a,
.form--text {
  color: #ff0000 !important;
}

.field__input {
  background: #000000 !important;
  border: 1px solid #ff0000 !important;
  border-color: #ff0000 !important;
  color: #ff0000 !important;
  outline: none !important;
  box-shadow: none !important;
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
  appearance: none !important;
}

.field__input:focus {
  border: 1px solid #ff0000 !important;
  border-color: #ff0000 !important;
  outline: none !important;
  box-shadow: none !important;
}

.field__input:hover {
  border: 1px solid #ff0000 !important;
  border-color: #ff0000 !important;
}

.field__button {
  background: #ff0000 !important;
  /* color: white !important; */
}

</style>

{% schema %}
{
  "name": "Footer - ODDMAN",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Configurações do Footer"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de Cores",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Inferior",
      "default": 36
    }
  ]
}
{% endschema %}

