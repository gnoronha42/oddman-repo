<!-- 
  FOOTER TEMPLATE PARA SHOPIFY - ODDMAN
  Use este template no seu tema Shopify
-->

<div class="section-background color-scheme-1"></div>
<div class="section color-scheme-1" style="width: 100%; max-width: 100%; padding: 0; margin: 0;">
  <div class="spacing-style layout-panel-flex layout-panel-flex--column section-content-wrapper" style="width: 100%; max-width: 100%;">

    <footer
      class="footer"
      style="
        --footer-bg: {{ section.settings.footer_bg_color | default: '#000000' }};
        --footer-accent: {{ section.settings.footer_accent_color | default: '#ff0000' }};
        --footer-accent-hover: {{ section.settings.footer_accent_hover_color | default: '#ff3333' }};
        --footer-accent-soft: {{ section.settings.footer_accent_soft_color | default: '#ff6666' }};
      "
    >
      <div class="footer__content-top">

        <div class="footer__blocks-wrapper">

          <details class="footer-block footer-block--menu">
            <summary class="footer-block__heading">{{ section.settings.col_1_title | default: 'Customer Care' }}</summary>
            <ul class="footer-block__details-content list-unstyled">
              <li>
                <a href="{{ section.settings.col_1_link_1_url | default: '/pages/faq' }}" class="link link--text">
                  {{- section.settings.col_1_link_1_label | default: 'FAQs' -}}
                </a>
              </li>
              <li>
                <a href="{{ section.settings.col_1_link_2_url | default: '/pages/info' }}" class="link link--text">
                  {{- section.settings.col_1_link_2_label | default: 'Contact Us' -}}
                </a>
              </li>
            </ul>
          </details>

          <details class="footer-block footer-block--menu">
            <summary class="footer-block__heading">{{ section.settings.col_2_title | default: 'Legal' }}</summary>
            <ul class="footer-block__details-content list-unstyled">
              <li>
                <a href="{{ section.settings.col_2_link_1_url | default: '/pages/info' }}" class="link link--text">
                  {{- section.settings.col_2_link_1_label | default: 'Terms & Conditions' -}}
                </a>
              </li>
              <li>
                <a href="{{ section.settings.col_2_link_2_url | default: '/pages/info' }}" class="link link--text">
                  {{- section.settings.col_2_link_2_label | default: 'Privacy Policy' -}}
                </a>
              </li>
              <li>
                <a href="{{ section.settings.col_2_link_3_url | default: '/pages/info' }}" class="link link--text">
                  {{- section.settings.col_2_link_3_label | default: 'Cookies Policy' -}}
                </a>
              </li>
            </ul>
          </details>

          {%- if section.settings.col_3_enabled -%}
            <details class="footer-block footer-block--menu footer-block--no-accordion-mobile" open>
              <summary class="footer-block__heading">{{ section.settings.col_3_title | default: 'Stockists' }}</summary>
              <div class="footer-block__details-content rte">
                {{ section.settings.col_3_content | default: '<p>Coming soon</p>' }}
              </div>
            </details>
          {%- endif -%}

          <details class="footer-block">
            <summary class="footer-block__heading">{{ section.settings.col_4_title | default: 'Follow' }}</summary>
            <div class="footer-block__details-content rte">
              <p>
                <a href="{{ section.settings.social_instagram | default: 'https://www.instagram.com/alldaodds/' }}"
                   target="_blank"
                   rel="noopener"
                   class="link link--text">
                  Instagram
                </a>
              </p>
              <p>
                <a href="{{ section.settings.social_facebook | default: 'https://www.facebook.com/oddman' }}"
                   target="_blank"
                   rel="noopener"
                   class="link link--text">
                  Facebook
                </a>
              </p>
            </div>
          </details>

          <div class="footer-block footer-block--newsletter-inline footer-block--no-accordion-mobile">
            <h2 class="footer-block__heading">{{ section.settings.newsletter_title | default: 'Join our community' }}</h2>
            <form method="post"
                  action="/contact#ContactFooter"
                  id="ContactFooter"
                  accept-charset="UTF-8"
                  class="footer__newsletter newsletter-form">

              <input type="hidden" name="form_type" value="customer">
              <input type="hidden" name="utf8" value="✓">
              <input type="hidden" name="contact[tags]" value="newsletter">

              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input id="NewsletterForm--footer"
                         type="email"
                         name="contact[email]"
                         class="field__input"
                         value=""
                         aria-required="true"
                         autocorrect="off"
                         autocapitalize="off"
                         autocomplete="email"
                         placeholder="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
                         required="">
                  <button type="submit"
                          class="newsletter-form__button field__button"
                          name="commit"
                          id="Subscribe"
                          aria-label="Subscribe">
                    {{ section.settings.newsletter_button_label | default: 'Subscribe' }}
                  </button>
                </div>
              </div>

              <span class="form--text">
                {{ section.settings.newsletter_privacy_text | default: 'You may unsubscribe at any time. To find out more, please visit our' }}
                <a class="privacyLink" href="{{ section.settings.newsletter_privacy_url | default: '/pages/privacy-policy' }}">Privacy Policy</a>.
              </span>
            </form>
          </div>

        </div>

      </div>
      
      <!-- Footer Bottom -->
      <div class="footer__content-bottom">
        <div class="footer__content-bottom-wrapper">
          <div class="footer__column footer__localization isolate"></div>
          <div class="footer__column footer__column--info">
            <p class="footer__copyright">
              © {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
            </p>
          </div>
        </div>
      </div>
      
    </footer>
  </div>
</div>

<!-- Adicione este CSS no final do arquivo ou no theme.liquid -->
<style>
/* ========================================
   FOOTER CUSTOM STYLES - ODDMAN
   ======================================== */

/* Container principal do footer */
.footer {
  /* Breakout technique para ocupar 100% da tela ignorando containers pai */
  width: 100vw !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  
  background: var(--footer-bg, #000000) !important;
  padding: 3rem 0 2rem !important;
  
  display: flex;
  flex-direction: column;
  align-items: stretch; /* Mudado de center para stretch para ocupar toda largura */
  
  /* Garantir que não há overflow */
  overflow-x: hidden !important;
  box-sizing: border-box !important;
}

.footer__content-top,
.footer__content-bottom {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 4% !important;
  box-sizing: border-box;
}

/* DESKTOP: grade estável para manter colunas alinhadas */
.footer__blocks-wrapper {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  align-items: start;
  gap: clamp(20px, 3vw, 42px);
  max-width: 1180px;
  margin: 0 auto 1.5rem !important;
  padding: 0 !important;
  width: 100%;
  box-sizing: border-box;
}

.footer-block {
  min-width: 0;
  width: 100%;
  text-align: left;
}

.footer-block--newsletter-inline {
  min-width: 0;
  max-width: none;
  width: 100%;
}

/* Estilos de summary (chevron mobile só) */
.footer-block summary {
  list-style: none;
  outline: none;
}
.footer-block summary::-webkit-details-marker { display: none; }
.footer-block summary::marker { display: none; }

/* Desktop: summary não-clicável (conteúdo sempre aberto via JS) */
@media (min-width: 769px) {
  .footer-block summary {
    cursor: default;
    pointer-events: none;
  }
}

.footer-block__heading {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--footer-accent, #ff0000);
  margin: 0 0 0.85rem 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-bottom: none;
  padding: 0;
  display: block;
  font-family: 'Arial', sans-serif;
  text-align: left;
}

.footer-block__details-content {
  text-align: left;
}

.footer-block__details-content ul {
  text-align: left;
  padding: 0;
  margin: 0;
  list-style: none;
}

/* MOBILE: accordion (clica no heading e expande) */
@media (max-width: 768px) {
  .footer__content-top,
  .footer__content-bottom {
    padding: 0 20px !important;
  }

  .footer__blocks-wrapper {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    max-width: 100%;
    margin: 0 !important;
  }

  .footer-block {
    width: 100%;
    min-width: 0;
    border-bottom: 1px solid var(--footer-accent, #ff0000);
    padding: 1rem 0;
  }
  .footer-block--newsletter-inline { max-width: 100%; }

  .footer-block summary {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0;
  }

  /* chevron > no mobile só nos blocos com accordion */
  details.footer-block:not(.footer-block--no-accordion-mobile) summary::after {
    content: '›';
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--footer-accent, #ff0000);
    line-height: 1;
    transition: transform 0.2s ease;
  }
  details.footer-block:not(.footer-block--no-accordion-mobile)[open] summary::after {
    transform: rotate(90deg);
  }

  .footer-block__details-content {
    padding-top: 0.75rem;
  }
}

/* Links dos menus */
.footer-block__details-content .link {
  color: var(--footer-accent, #ff0000);
  text-decoration: none;
  font-size: 0.95rem;
  transition: color 0.3s ease;
  display: block;
  margin-bottom: 0.5rem;
  font-family: 'Arial', sans-serif;
  font-weight: 400;
  text-align: left;
}

.footer-block__details-content .link:hover {
  color: var(--footer-accent-hover, #ff3333);
  text-decoration: underline;
}

/* Lista de links */
.footer-block__details-content ul {
  list-style: none;
  padding: 0;
  margin: 0;
  text-align: left;
  display: block;
}

.footer-block__details-content li {
  margin-bottom: 0.4rem;
  text-align: left;
}

/* Conteúdo dos blocos com texto (Stockists, Follow) */
.footer-block__details-content p {
  text-align: left;
  margin-bottom: 0.5rem;
}

.footer-block__details-content p a {
  text-align: left;
}

/* Newsletter inline - na mesma linha dos outros blocos */
.footer-block--newsletter-inline {
  text-align: left;
}

.footer-block--newsletter-inline .footer-block__heading {
  font-size: 1.1rem;
  color: var(--footer-accent, #ff0000);
  border-bottom: none;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 1rem;
  font-family: 'Arial', sans-serif;
  font-weight: 600;
}

/* Formulário de newsletter */
.newsletter-form {
  margin-bottom: 1rem;
}

.newsletter-form__field-wrapper {
  display: flex;
  flex-direction: column;
  max-width: none;
  margin: 0 0 0.5rem 0;
  border-radius: 0;
  overflow: hidden;
  box-shadow: none;
  gap: 0.5rem;
}

.newsletter-form__field-wrapper .field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 100%;
}

.field__input {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid #ff0000 !important;
  outline: none !important;
  font-size: 0.95rem;
  background: var(--footer-bg, #000000) !important;
  color: var(--footer-accent, #ff0000) !important;
  font-family: 'Arial', sans-serif;
  box-shadow: none !important;
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
  appearance: none !important;
  box-sizing: border-box;
}

.field__input::placeholder {
  color: var(--footer-accent-soft, #ff6666);
}

.field__button {
  background: var(--footer-accent, #ff0000);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.3s ease;
  font-family: 'Arial', sans-serif;
  width: 100%;
  box-sizing: border-box;
}

.field__button:hover {
  background: var(--footer-accent-hover, #ff3333);
}

/* Texto do formulário */
.form--text {
  font-size: 0.65rem;
  color: var(--footer-accent, #ff0000);
  line-height: 1.3;
  font-family: 'Arial', sans-serif;
  text-transform: uppercase;
  display: block;
  max-width: 100%;
}

.form--text .privacyLink {
  color: var(--footer-accent, #ff0000);
  text-decoration: none;
}

.form--text .privacyLink:hover {
  text-decoration: underline;
}

/* Footer bottom */
.footer__content-bottom {
  border-top: none;
  padding-top: 1.5rem;
  text-align: center;
  color: var(--footer-accent, #ff0000);
}

/* Ajustes específicos para mobile */
@media (max-width: 768px) {
  .footer-block__heading {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
  
  .newsletter-form__field-wrapper {
    flex-direction: column !important;
    max-width: 100%;
    margin: 0 auto;
  }

  .newsletter-form__field-wrapper .field {
    flex-direction: column !important;
    width: 100%;
  }
  
  .field__input {
    width: 100% !important;
    margin-bottom: 0;
  }
  
  .field__button {
    width: 100% !important;
  }
  
  .form--text {
    font-size: 0.6rem;
    text-align: center;
    margin-top: 0.5rem;
  }
}


@media (max-width: 768px) {
  .footer-block__details-content .link,
  .footer-block__details-content ul,
  .footer-block__details-content li,
  .footer-block__details-content p,
  .footer-block__details-content p a,
  .footer-block--newsletter-inline {
    text-align: center;
  }
}

/* Animações suaves */
.footer-block {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease forwards;
}

.footer-block:nth-child(1) { animation-delay: 0.1s; }
.footer-block:nth-child(2) { animation-delay: 0.2s; }
.footer-block:nth-child(3) { animation-delay: 0.3s; }
.footer-block:nth-child(4) { animation-delay: 0.4s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Melhorias de acessibilidade */
.footer-block__heading:focus {
  outline: 2px solid #3498db;
  outline-offset: 2px;
}

.field__input:focus {
  outline: none !important;
  border: 1px solid #ff0000 !important;
  box-shadow: none !important;
}

.field__button:focus {
  outline: 2px solid #ff0000;
  outline-offset: 2px;
}

/* Estilo consistente - sempre preto e vermelho */
.footer {
  background: var(--footer-bg, #000000) !important;
}

/* Remover bordas brancas específicas */
.footer,
.footer__content-top,
.footer__content-bottom {
  border: none !important;
  outline: none !important;
}

.footer-block__heading,
.footer-block__details-content .link,
.footer-block__details-content p,
.footer-block__details-content a,
.form--text {
  color: var(--footer-accent, #ff0000) !important;
}

.field__input {
  background: var(--footer-bg, #000000) !important;
  border: 1px solid #ff0000 !important;
  border-color: var(--footer-accent, #ff0000) !important;
  color: var(--footer-accent, #ff0000) !important;
  outline: none !important;
  box-shadow: none !important;
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
  appearance: none !important;
}

.field__input:focus {
  border: 1px solid #ff0000 !important;
  border-color: var(--footer-accent, #ff0000) !important;
  outline: none !important;
  box-shadow: none !important;
}

.field__input:hover {
  border: 1px solid #ff0000 !important;
  border-color: var(--footer-accent, #ff0000) !important;
}

.field__button {
  background: var(--footer-accent, #ff0000) !important;
  color: #ffffff !important;
}

</style>

<script>
  (function () {
    var mq = window.matchMedia('(max-width: 768px)');
    function applyFooterAccordion() {
      var isMobile = mq.matches;
      document.querySelectorAll('.footer details.footer-block').forEach(function (d) {
        if (d.classList.contains('footer-block--no-accordion-mobile')) {
          d.open = true;
        } else {
          d.open = !isMobile;
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyFooterAccordion);
    } else {
      applyFooterAccordion();
    }
    if (mq.addEventListener) {
      mq.addEventListener('change', applyFooterAccordion);
    } else if (mq.addListener) {
      mq.addListener(applyFooterAccordion);
    }
  })();
</script>

{% schema %}
