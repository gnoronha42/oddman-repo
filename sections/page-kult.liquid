{% liquid
  assign accent_color = section.settings.accent_color | default: '#ff0000'
  assign background_color = section.settings.background_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#cccccc'
  assign heading_color = section.settings.heading_color | default: '#ffffff'
  assign button_bg = section.settings.button_bg | default: '#ff0000'
  assign button_hover_bg = section.settings.button_hover_bg | default: '#cc0000'
  assign button_text = section.settings.button_text_color | default: '#ffffff'
%}

<style>
  #kult-{{ section.id }} {
    --kult-accent: {{ accent_color }};
    --kult-bg: {{ background_color }};
    --kult-text: {{ text_color }};
    --kult-heading: {{ heading_color }};
    --kult-btn-bg: {{ button_bg }};
    --kult-btn-hover-bg: {{ button_hover_bg }};
    --kult-btn-text: {{ button_text }};
  }

  /* Reset e Fontes Base */
  .kult-page-wrapper {
    background-color: var(--kult-bg);
    color: var(--kult-heading);
    font-family: 'Arial', 'Helvetica', sans-serif;
    overflow-x: hidden;
    width: 100%;
  }

  .kult-page-wrapper h1,
  .kult-page-wrapper h2,
  .kult-page-wrapper h3 {
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: 1px;
    margin: 0;
    line-height: 0.9;
  }

  .kult-page-wrapper p {
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    color: var(--kult-text);
  }

  .kult-page-wrapper strong {
    color: var(--kult-heading);
  }

  /* Botões */
  .kult-btn {
    background-color: var(--kult-btn-bg);
    color: var(--kult-btn-text);
    border: none;
    padding: 12px 24px;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 0.9rem;
    cursor: pointer;
    position: absolute;
    text-decoration: none;
    display: inline-block;
    transition: background 0.3s ease;
    top: 80%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .kult-btn:hover {
    background-color: var(--kult-btn-hover-bg);
  }

  .kult-page-wrapper img,
  .kult-page-wrapper picture,
  .kult-page-wrapper video,
  .kult-page-wrapper canvas,
  .kult-page-wrapper svg {
    position: relative;
    max-width: 100%;
    justify-content: flex-end;
    left: 3%;
  }

  @media (max-width: 1050px) {
    .kult-page-wrapper img,
    .kult-page-wrapper picture,
    .kult-page-wrapper video,
    .kult-page-wrapper canvas,
    .kult-page-wrapper svg {
      left: 4%;
    }
  }

  /* SEÇÕES GERAIS */
  .kult-section {
    padding: 2rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* 2. Hero Section */
  .kult-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
  }

  .kult-hero-video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .kult-hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 25% center;
    transform: none;
  }

  .kult-hero .kult-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    margin: 0;
  }

  .kult-hero h1 {
    font-size: clamp(4rem, 15vw, 12rem);
    color: var(--kult-heading);
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #fff, #ccc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 3. Seção "The Journey" */
  .kult-journey {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .kult-journey .left {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .kult-journey .left h2 {
    font-size: clamp(3rem, 5vw, 5rem);
    color: var(--kult-accent);
    margin-bottom: 1rem;
  }

  .kult-journey .left p {
    color: var(--kult-accent);
  }

  .the-journey-svg {
    width: clamp(250px, 50vw, 500px);
    height: auto;
    margin-bottom: 0.9rem;
  }

  .kult-journey .right {
    flex: 1;
    position: relative;
  }

  .kult-journey .right img.main-img,
  .kult-journey .right .main-video {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .kult-journey .badge {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 120px;
    height: 120px;
    background: var(--kult-badge-bg) no-repeat center center;
    background-size: contain;
    z-index: 2;
  }

  /* 4. Vídeo do logo ODDMAN centralizado com JOIN THE KULT */
  .kult-wide-image {
    width: 100%;
    max-width: 1200px;
    margin: 2rem auto 2rem;
    padding: 0 20px;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .kult-wide-image__video-wrap {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .kult-wide-image img,
  .kult-wide-video {
    width: 100%;
    height: auto;
    max-height: 500px;
    display: block;
    margin: 0 auto;
    object-fit: contain;
  }

  .kult-wide-image__btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 12px 32px;
    background: var(--kult-btn-bg, #b22222);
    color: var(--kult-btn-text, #ffffff);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .kult-wide-image__btn:hover {
    background: var(--kult-btn-hover-bg, #8b1a1a);
    color: var(--kult-btn-text, #ffffff);
  }

  @media (max-width: 768px) {
    .kult-wide-image {
      padding: 0 16px;
      margin: 1.5rem auto 1.5rem;
    }
    .kult-wide-image__video-wrap {
      max-width: 100%;
      margin-bottom: 1rem;
    }
    .kult-wide-image img,
    .kult-wide-video {
      max-height: 300px;
    }
    .kult-wide-image__btn {
      padding: 10px 24px;
      font-size: 0.85rem;
    }
  }

  /* 4.1 Banner largo depois do The Journey */
  .kult-journey-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-top: 2rem;
    margin-bottom: 2rem;
    overflow: hidden;
  }

  .kult-journey-banner__media {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .kult-journey-banner {
      margin-top: 1rem;
      margin-bottom: 1rem;
    }
  }

  /* 5. Section "Who Rocks It" */
  .kult-who-rocks {
    text-align: center;
  }

  .kult-who-rocks h2 {
    font-size: 2rem;
    color: var(--kult-accent);
    margin-bottom: 1rem;
    text-align: center;
  }

  .kult-collage {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .kult-collage img {
    width: 100%;
    height: auto;
    display: block;
  }

  .kult-collage img:hover {
    transform: scale(1.02);
    border-color: var(--kult-accent);
  }

  /* 6. Section "The Kult Lifestyle" */
  .kult-lifestyle {
    text-align: center;
  }

  .kult-lifestyle h2 {
    font-size: 2.5rem;
    color: var(--kult-accent);
    margin-bottom: 1rem;
  }

  .kult-model-grid {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .kult-model-grid figure {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .kult-model-grid img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 7. Section "Our Vibes" */
  .kult-vibes {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .kult-vibes .image-left {
    flex: 1;
  }

  .kult-vibes .image-left img {
    width: 100%;
    height: auto;
    display: block;
  }

  .kult-vibes .content-right {
    flex: 1;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .kult-vibes .content-right h2 {
    font-size: clamp(3rem, 5vw, 5rem);
    color: var(--kult-accent);
    margin-bottom: 1.5rem;
  }

  .our-vibes-svg {
    width: clamp(200px, 40vw, 400px);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .kult-vibes .content-right p {
    color: var(--kult-accent);
  }

  /* 8. Slider Dots (Visual) */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 2rem 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #333;
    border-radius: 50%;
  }

  .dot.active {
    background-color: var(--kult-accent);
  }

  /* Responsividade */
  @media (max-width: 768px) {
    .kult-hero h1 {
      font-size: 4rem;
    }

    .kult-journey,
    .kult-vibes {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .kult-vibes {
      flex-direction: column-reverse;
    }

    .kult-vibes .content-right {
      align-items: center;
      text-align: center;
    }

    .kult-journey .left {
      align-items: center;
    }

    .kult-model-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .kult-collage {
      grid-template-columns: 1fr;
    }

    .kult-btn {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      display: block !important;
      width: fit-content;
      margin: 1.5rem auto 0 !important;
    }

    .kult-hero-section {
      position: relative;
      width: 100%;
      height: 100vh;
      overflow: hidden;
    }

    .kult-hero-section .kult-btn {
      position: absolute;
      bottom: -80%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 10;
    }

    .kult-journey .left,
    .kult-vibes .content-right {
      position: relative;
    }

    .kult-journey .left .kult-btn,
    .kult-vibes .content-right .kult-btn {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: 1.5rem auto 0;
    }

    .kult-section {
      padding: 1.5rem 1rem;
    }

    .kult-journey .left p,
    .kult-vibes .content-right p {
      margin-bottom: 1rem;
    }
  }

  /* Carousel CSS */
  .kult-carousel-container {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 400px;
    padding: 30px;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kult-carousel-track {
    display: grid;
    grid-template-areas: 'stack';
    width: 100%;
    max-width: 90%;
    position: relative;
  }

  .kult-carousel-slide {
    grid-area: stack;
    width: 100%;
    height: auto;
    opacity: 1;
    transition: all 0.8s cubic-bezier(0.25, 0.8, 0.25, 1);
    z-index: 1;
    position: relative;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .kult-carousel-slide.active {
    z-index: 10;
    transform: rotate(0deg) scale(1) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .kult-carousel-slide:nth-child(1) { transform: rotate(-4deg); }
  .kult-carousel-slide:nth-child(2) { transform: rotate(3deg); }
  .kult-carousel-slide:nth-child(3) { transform: rotate(-2deg); }
  .kult-carousel-slide:nth-child(4) { transform: rotate(5deg); }
  .kult-carousel-slide:nth-child(odd) { transform: rotate(-3deg); }
  .kult-carousel-slide:nth-child(even) { transform: rotate(3deg); }

  .kult-carousel-slide img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .carousel-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 2;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .dot.active {
    background-color: var(--kult-accent);
  }
</style>

{%- liquid
  assign hero_video = section.settings.hero_video
  assign journey_image = section.settings.journey_image
  assign journey_svg = section.settings.journey_svg
  assign journey_badge = section.settings.journey_badge_image
  assign wide_video = section.settings.wide_video
  assign wide_image = section.settings.wide_image
  assign journey_banner_video = section.settings.journey_banner_video
  assign journey_banner_image = section.settings.journey_banner_image
  assign who_rocks_image = section.settings.who_rocks_image
  assign lifestyle_image = section.settings.lifestyle_image
  assign vibes_svg = section.settings.vibes_svg

  if journey_badge != blank
    assign badge_url = journey_badge | image_url: width: 240
  else
    assign badge_url = 'roses.png' | asset_url
  endif

  comment
    Apenas um vídeo na página: se o banner largo estiver ativo, o hero full-screen não renderiza.
  endcomment
  assign show_hero_render = section.settings.show_hero
  if section.settings.show_wide_banner
    assign show_hero_render = false
  endif
-%}

<div
  id="kult-{{ section.id }}"
  class="kult-page-wrapper"
  style="--kult-badge-bg: url('{{ badge_url }}');"
>
  {%- if show_hero_render -%}
    <section class="kult-hero-section" style="position: relative; width: 100%; height: 100vh; overflow: hidden;">
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
        {%- if hero_video != blank -%}
          {{
            hero_video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              class: 'kult-hero-video',
              style: 'width:100%;height:100%;object-fit:cover;'
          }}
        {%- else -%}
          <video autoplay muted loop style="width: 100%; height: 100%; object-fit: cover;">
            <source src="{{ 'oddmangif.mp4' | asset_url }}" type="video/mp4">
          </video>
        {%- endif -%}
      </div>
      <a href="{{ section.settings.hero_button_link | default: '/products' }}" class="kult-btn">
        {{- section.settings.hero_button_label | default: 'JOIN THE KULT' -}}
      </a>
    </section>
  {%- endif -%}

  {%- if section.settings.show_wide_banner -%}
    <section class="kult-wide-image">
      <div class="kult-wide-image__video-wrap">
        {%- if wide_video != blank -%}
          {{
            wide_video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'kult-wide-video'
          }}
        {%- elsif wide_image != blank -%}
          {{
            wide_image
            | image_url: width: 1200
            | image_tag:
              alt: wide_image.alt,
              class: 'kult-wide-video',
              loading: 'lazy'
          }}
        {%- else -%}
          <video autoplay muted loop playsinline class="kult-wide-video">
            <source src="{{ 'oddmangif.mp4' | asset_url }}" type="video/mp4">
          </video>
        {%- endif -%}
      </div>
      {%- if section.settings.wide_banner_button_label != blank -%}
        <a
          href="{{ section.settings.wide_banner_button_link | default: '/products' }}"
          class="kult-wide-image__btn"
        >
          {{- section.settings.wide_banner_button_label -}}
        </a>
      {%- else -%}
        <a href="/products" class="kult-wide-image__btn">JOIN THE KULT</a>
      {%- endif -%}
    </section>
  {%- endif -%}

  {%- if section.settings.show_journey -%}
    <section class="kult-section kult-journey">
      <div class="left">
        {%- if journey_svg != blank -%}
          {{
            journey_svg
            | image_url: width: 1000
            | image_tag:
              alt: journey_svg.alt | default: 'The Journey',
              class: 'the-journey-svg',
              loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'the-journey-2.svg' | asset_url }}" alt="The Journey" class="the-journey-svg" loading="lazy">
        {%- endif -%}

        {%- if section.settings.journey_text != blank -%}
          {{ section.settings.journey_text }}
        {%- else -%}
          <p>**"ODDMAN began in 2021 in Nigeria with one belief: being different is a strength. We're not here to follow trends — we're here to challenge them. ODDMAN is more than a brand; it's a lifestyle and a mindset.</p>
          <p>KULT represents our community — a place for people who embrace individuality, creativity, and bold self-expression.</p>
        {%- endif -%}
      </div>
      <div class="right">
        {%- if journey_image != blank -%}
          {{
            journey_image
            | image_url: width: 1600
            | image_tag:
              alt: journey_image.alt | default: 'The Journey',
              class: 'main-img',
              loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'jon poster.png' | asset_url }}" alt="The Journey" class="main-img" loading="lazy">
        {%- endif -%}
        {%- if section.settings.show_journey_badge -%}
          <div class="badge"></div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_journey_banner -%}
    <section class="kult-journey-banner">
      {%- if journey_banner_video != blank -%}
        {{
          journey_banner_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            class: 'kult-journey-banner__media'
        }}
      {%- elsif journey_banner_image != blank -%}
        {{
          journey_banner_image
          | image_url: width: 2400
          | image_tag:
            alt: journey_banner_image.alt | default: 'ODDMAN Banner',
            class: 'kult-journey-banner__media',
            loading: 'lazy'
        }}
      {%- else -%}
        <video
          autoplay
          muted
          loop
          playsinline
          class="kult-journey-banner__media"
        >
          <source src="{{ 'oddmanpresentervideo.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}
    </section>
  {%- endif -%}

  {%- if section.settings.show_who_rocks -%}
    <section class="kult-section kult-who-rocks">
      <h2>{{ section.settings.who_rocks_title | default: 'ØDDMAN Kulture: Who Rocks It' }}</h2>
      <div class="kult-collage">
        {%- if who_rocks_image != blank -%}
          {{
            who_rocks_image
            | image_url: width: 3840
            | image_tag:
              alt: who_rocks_image.alt | default: 'Who rocks it',
              loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'od x khaid poster.png' | asset_url }}" alt="OD x Khaid Poster" loading="lazy">
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_lifestyle -%}
    <section class="kult-section kult-lifestyle">
      <h2>{{ section.settings.lifestyle_title | default: 'The Kult Lifestyle' }}</h2>
      <div class="kult-model-grid">
        {%- if lifestyle_image != blank -%}
          {{
            lifestyle_image
            | image_url: width: 3840
            | image_tag:
              alt: lifestyle_image.alt | default: 'Lifestyle',
              loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'kult poster.png' | asset_url }}" alt="Lifestyle 1" loading="lazy">
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_vibes -%}
    <section class="kult-section kult-vibes">
      <div class="image-left kult-carousel-container">
        <div class="kult-carousel-track">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="kult-carousel-slide {% if forloop.first %}active{% endif %}">
                <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | default: 'Kult Vibe' }}" loading="lazy">
              </div>
            {% endfor %}
          {% else %}
            <div class="kult-carousel-slide active">
              <img src="{{ 'oddman-carrousel1.png' | asset_url }}" alt="Our Vibes 1" loading="lazy">
            </div>
            <div class="kult-carousel-slide">
              <img src="{{ 'oddman-carrousel2.png' | asset_url }}" alt="Our Vibes 2" loading="lazy" onerror="this.style.display='none'; this.parentElement.style.display='none';">
            </div>
            <div class="kult-carousel-slide">
              <img src="{{ 'oddman-carrousel3.jpeg' | asset_url }}" alt="Our Vibes 3" loading="lazy">
            </div>
          {% endif %}
        </div>
        <div class="carousel-dots">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="dot {% if forloop.first %}active{% endif %}" onclick="goToSlide({{ forloop.index0 }})"></div>
            {% endfor %}
          {% else %}
            <div class="dot active" onclick="goToSlide(0)"></div>
            <div class="dot" onclick="goToSlide(1)"></div>
            <div class="dot" onclick="goToSlide(2)"></div>
          {% endif %}
        </div>
      </div>
      <div class="content-right">
        {%- if vibes_svg != blank -%}
          {{
            vibes_svg
            | image_url: width: 1000
            | image_tag:
              alt: vibes_svg.alt | default: 'Our Vibes',
              class: 'our-vibes-svg',
              loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'our-vibes.svg' | asset_url }}" alt="Our Vibes" class="our-vibes-svg" loading="lazy">
        {%- endif -%}
        {%- if section.settings.vibes_text != blank -%}
          {{ section.settings.vibes_text }}
        {%- else -%}
          <p>We host ODDMAN events across Toronto, the UK, and Nigeria — bringing our community together wherever the culture moves. Our gatherings connect creatives, thinkers, and the boldly different. With every city we touch, we push for global impact and steady growth, always aiming to build one of the strongest worldwide communities in fashion and lifestyle.</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function() {
    let currentSlide = 0;
    let slideInterval;
    const slideDuration = {{ section.settings.carousel_interval | default: 3000 }};

    function showSlide(index) {
      const slides = document.querySelectorAll('#kult-{{ section.id }} .kult-carousel-slide');
      const dots = document.querySelectorAll('#kult-{{ section.id }} .dot');

      if (slides.length === 0) return;

      if (index >= slides.length) currentSlide = 0;
      else if (index < 0) currentSlide = slides.length - 1;
      else currentSlide = index;

      slides.forEach((slide, i) => {
        slide.classList.remove('active');
        if (dots[i]) dots[i].classList.remove('active');

        if (i === currentSlide) {
          slide.classList.add('active');
          if (dots[i]) dots[i].classList.add('active');
        }
      });
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }

    window.goToSlide = function(index) {
      showSlide(index);
      clearInterval(slideInterval);
      slideInterval = setInterval(nextSlide, slideDuration);
    };

    document.addEventListener('DOMContentLoaded', function() {
      if (document.querySelector('#kult-{{ section.id }} .kult-carousel-slide')) {
        slideInterval = setInterval(nextSlide, slideDuration);
      }

      {%- if section.settings.hero_button_opens_newsletter -%}
        const kultButtons = document.querySelectorAll('#kult-{{ section.id }} .kult-btn');
        const newsletterModal = document.querySelector('#newsletter-modal');

        if (kultButtons.length > 0 && newsletterModal) {
          kultButtons.forEach(button => {
            button.addEventListener('click', function(e) {
              e.preventDefault();
              try {
                if (newsletterModal && typeof newsletterModal.showDialog === 'function') {
                  newsletterModal.showDialog();
                }
              } catch (err) {
                console.warn('Erro ao abrir modal de newsletter:', err);
              }
            });
          });
        }
      {%- endif -%}
    });
  })();
</script>

