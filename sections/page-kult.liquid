<style>
  /* Reset e Fontes Base */
  .kult-page-wrapper {
    background-color: #000000;
    color: #ffffff;
    font-family: 'Arial', 'Helvetica', sans-serif;
    overflow-x: hidden;
    width: 100%;
  }

  .kult-page-wrapper h1, 
  .kult-page-wrapper h2, 
  .kult-page-wrapper h3 {
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: 1px;
    margin: 0;
    line-height: 0.9;
  }

  .kult-page-wrapper p {
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    color: #cccccc;
  }

  .kult-page-wrapper strong {
    color: #ffffff;
  }

  /* Botões */
  .kult-btn {
    background-color: #ff0000;
    color: #ffffff;
    border: none;
    padding: 12px 24px;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 0.9rem;
    cursor: pointer;
    position: absolute;
    text-decoration: none;
    display: inline-block;
    transition: background 0.3s ease;
    /* Centralização perfeita */
    top: 80%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }




  

  .kult-btn:hover {
    background-color: #cc0000;
  }


img, picture, video, canvas, svg {
    position: relative;
    max-width: 100%;
    justify-content: flex-end;
    left: 3%;
   
}

@media (max-width: 1050px) {
  img, picture, video, canvas, svg {
    left:4% ;
    
  }
}

  /* SEÇÕES GERAIS */
  .kult-section {
    padding: 2rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* 2. Hero Section */
  .kult-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
  }

  .kult-hero-video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .kult-hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 25% center;
    transform: none;
  }

  .kult-hero .kult-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    margin: 0;
  }

  .kult-hero h1 {
    font-size: clamp(4rem, 15vw, 12rem);
    color: #ffffff;
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #fff, #ccc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 3. Seção "The Journey" */
  .kult-journey {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .kult-journey .left {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .kult-journey .left h2 {
    font-size: clamp(3rem, 5vw, 5rem);
    color: #ff0000;
    margin-bottom: 1rem;
  }
  
  .kult-journey .left p {
    color: #ff0000;
  }

  .the-journey-svg {
    width: clamp(250px, 50vw, 500px);
    height: auto;
    margin-bottom: 0.9rem;
  }

  .kult-journey .right {
    flex: 1;
    position: relative;
  }

  .kult-journey .right img.main-img,
  .kult-journey .right .main-video {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .kult-journey .badge {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 120px;
    height: 120px;
    background: url("{{ 'roses.png' | asset_url }}") no-repeat center center;
    background-size: contain;
    z-index: 2;
  }
  
  /* 4. Giant Image Banner */
  .kult-wide-image {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .kult-wide-image img,
  .kult-wide-video {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 5. Section “Who Rocks It” */
  .kult-who-rocks {
    text-align: center;
  }

  .kult-who-rocks h2 {
    font-size: 2rem;
    color: #ff0000;
    margin-bottom: 1rem;
    text-align: center;
  }

  .kult-collage {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .kult-collage img {
    width: 100%;
    height: auto;
    display: block;
  }

  .kult-collage img:hover {
    transform: scale(1.02);
    border-color: #ff0000;
  }

  /* 6. Section “The Kult Lifestyle” */
  .kult-lifestyle {
    text-align: center;
  }

  .kult-lifestyle h2 {
    font-size: 2.5rem;
    color: #ff0000;
    margin-bottom: 1rem;
  }

  .kult-model-grid {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .kult-model-grid figure {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .kult-model-grid img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 7. Section “Our Vibes” */
  .kult-vibes {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .kult-vibes .image-left {
    flex: 1;
  }

  .kult-vibes .image-left img {
    width: 100%;
    height: auto;
    display: block;
  }

  .kult-vibes .content-right {
    flex: 1;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .kult-vibes .content-right h2 {
    font-size: clamp(3rem, 5vw, 5rem);
    color: #ff0000;
    margin-bottom: 1.5rem;
  }

  .our-vibes-svg {
    width: clamp(200px, 40vw, 400px);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .kult-vibes .content-right p {
    color: #ff0000;
  }

  /* 8. Slider Dots (Visual) */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 2rem 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #333;
    border-radius: 50%;
  }
  .dot.active {
    background-color: #ff0000;
  }

  /* Responsividade */
  @media (max-width: 768px) {
    .kult-hero h1 {
      font-size: 4rem;
    }
    
    .kult-journey,
    .kult-vibes {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .kult-vibes {
      flex-direction: column-reverse;
    }
    
    .kult-vibes .content-right {
      align-items: center;
      text-align: center;
    }

    .kult-journey .left {
      align-items: center;
    }

    .kult-model-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .kult-collage {
      grid-template-columns: 1fr;
    }

    /* Ajustes para botões no mobile */
    .kult-btn {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      display: block !important;
      width: fit-content;
      margin: 1.5rem auto 0 !important;
    }

    /* Primeira seção hero - botão centralizado */
    .kult-hero-section {
      position: relative;
      width: 100%;
      height: 100vh;
      overflow: hidden;
    }

    .kult-hero-section .kult-btn {
      position: absolute;
      bottom: -80%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 10;
    }

    /* Seções com conteúdo - botão no fluxo */
    .kult-journey .left,
    .kult-vibes .content-right {
      position: relative;
    }

    .kult-journey .left .kult-btn,
    .kult-vibes .content-right .kult-btn {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: 1.5rem auto 0;
    }

    /* Ajustes gerais de padding e espaçamento */
    .kult-section {
      padding: 1.5rem 1rem;
    }

    .kult-journey .left p,
    .kult-vibes .content-right p {
      margin-bottom: 1rem;
    }
  }

  /* Carousel CSS */
  .kult-carousel-container {
      position: relative;
      width: 100%;
      height: auto;
      min-height: 400px;
      padding: 30px; /* Espaço para as rotações não cortarem */
      overflow: visible; /* Permite ver as bordas das imagens rotacionadas */
      display: flex;
      align-items: center;
      justify-content: center;
  }

  .kult-carousel-track {
      display: grid;
      grid-template-areas: "stack";
      width: 100%;
      max-width: 90%; /* Margem de segurança */
      position: relative;
  }

  .kult-carousel-slide {
      grid-area: stack;
      width: 100%;
      height: auto;
      opacity: 1; /* Todas visíveis para o efeito de pilha */
      transition: all 0.8s cubic-bezier(0.25, 0.8, 0.25, 1);
      z-index: 1;
      position: relative;
      box-shadow: 0 5px 15px rgba(0,0,0,0.5);
      background: #000;
      border: 1px solid rgba(255,255,255,0.1); /* Borda sutil para separar imagens escuras */
  }

  .kult-carousel-slide.active {
      z-index: 10;
      transform: rotate(0deg) scale(1) !important;
      box-shadow: 0 20px 50px rgba(0,0,0,0.8);
      border: 1px solid rgba(255,255,255,0.2);
  }

  /* Rotações alternadas para criar o efeito bagunçado */
  .kult-carousel-slide:nth-child(1) { transform: rotate(-4deg); }
  .kult-carousel-slide:nth-child(2) { transform: rotate(3deg); }
  .kult-carousel-slide:nth-child(3) { transform: rotate(-2deg); }
  .kult-carousel-slide:nth-child(4) { transform: rotate(5deg); }
  .kult-carousel-slide:nth-child(odd) { transform: rotate(-3deg); }
  .kult-carousel-slide:nth-child(even) { transform: rotate(3deg); }

  .kult-carousel-slide img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
  }

  .carousel-dots {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      z-index: 2;
  }

  .dot {
      width: 10px;
      height: 10px;
      background-color: rgba(255, 255, 255, 0.5);
      border-radius: 50%;
      cursor: pointer;
      transition: background-color 0.3s;
  }

  .dot.active {
      background-color: #ff0000;
  }
</style>

<div class="kult-page-wrapper">

  <!-- 2. Hero Section -->
  <section class="kult-hero-section" style="position: relative; width: 100%; height: 100vh; overflow: hidden;">
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
      <video autoplay muted loop style="width: 100%; height: 100%; object-fit: cover;">
        <source src="{{ 'oddmangif.mp4' | asset_url }}" type="video/mp4">
      </video>
    </div>
    <a href="/products" class="kult-btn">JOIN THE KULT</a>
  </section>

  <!-- 3. Seção "The Journey" -->
  <section class="kult-section kult-journey">
    <div class="left">
      <img src="{{ 'the-journey-2.svg' | asset_url }}" alt="The Journey" class="the-journey-svg">
      <p>
        **“ODDMAN began in 2021 in Nigeria with one belief: being different is a strength. We’re not here to follow trends — we’re here to challenge them. ODDMAN is more than a brand; it’s a lifestyle and a mindset.
      </p>
      <p>
        KULT represents our community — a place for people who embrace individuality, creativity, and bold self-expression.
      </p>
    </div>
    <div class="right">
      <img src="{{ 'jon poster.png' | asset_url }}" alt="The Journey" class="main-img">
      <div class="badge"></div>
    </div>
  </section>

  <!-- 4. Giant Image Banner -->
  <section class="kult-wide-image">
    <video autoplay muted loop class="kult-wide-video">
      <source src="{{ 'oddmanpresentervideo.mp4' | asset_url }}" type="video/mp4">
    </video>
  </section>

  <!-- 5. Section "Who Rocks It" -->
  <section class="kult-section kult-who-rocks">
    <h2>ØDDMAN Kulture: Who Rocks It</h2>
    <div class="kult-collage">
      <img src="{{ 'od x khaid poster.png' | asset_url }}" alt="OD x Khaid Poster">
    </div>
    
  </section>

  <!-- 6. Section "The Kult Lifestyle" -->
  <section class="kult-section kult-lifestyle">
    <h2>The Kult Lifestyle</h2>
    <div class="kult-model-grid">
    <img src="{{ 'kult poster.png' | asset_url }}" alt="Lifestyle 1">
    </div>
  </section>

  <!-- 7. Section "Our Vibes" -->
  <section class="kult-section kult-vibes">
    <div class="image-left kult-carousel-container">
       <div class="kult-carousel-track">
          {% if section.blocks.size > 0 %}
             {% for block in section.blocks %}
               <div class="kult-carousel-slide {% if forloop.first %}active{% endif %}">
                  <img src="{{ block.settings.image | image_url }}" alt="Kult Vibe">
               </div>
             {% endfor %}
          {% else %}
             <div class="kult-carousel-slide active">
                <img src="{{ 'oddman-carrousel1.png' | asset_url }}" alt="Our Vibes 1">
             </div>
             <div class="kult-carousel-slide">
                <img src="{{ 'oddman-carrousel3.jpeg' | asset_url }}" alt="Our Vibes 2">
             </div>
          {% endif %}
       </div>
       <div class="carousel-dots">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="dot {% if forloop.first %}active{% endif %}" onclick="goToSlide({{ forloop.index0 }})"></div>
            {% endfor %}
          {% else %}
            <div class="dot active" onclick="goToSlide(0)"></div>
            <div class="dot" onclick="goToSlide(1)"></div>
          {% endif %}
       </div>
    </div>
    <div class="content-right">
      <img src="{{ 'our-vibes.svg' | asset_url }}" alt="Our Vibes" class="our-vibes-svg">
      <p>
        We host ODDMAN events across Toronto, the UK, and Nigeria — bringing our community together wherever the culture moves. Our gatherings connect creatives, thinkers, and the boldly different. With every city we touch, we push for global impact and steady growth, always aiming to build one of the strongest worldwide communities in fashion and lifestyle.
      </p>
    </div>
  </section>
</div>

<script>
  let currentSlide = 0;
  let slideInterval;
  const slideDuration = 3000;

  function showSlide(index) {
    const slides = document.querySelectorAll('.kult-carousel-slide');
    const dots = document.querySelectorAll('.dot');
    
    if (slides.length === 0) return;

    if (index >= slides.length) currentSlide = 0;
    else if (index < 0) currentSlide = slides.length - 1;
    else currentSlide = index;

    slides.forEach((slide, i) => {
      slide.classList.remove('active');
      if (dots[i]) dots[i].classList.remove('active');
      
      if (i === currentSlide) {
        slide.classList.add('active');
        if (dots[i]) dots[i].classList.add('active');
      }
    });
  }

  function nextSlide() {
    showSlide(currentSlide + 1);
  }

  function goToSlide(index) {
    showSlide(index);
    resetInterval();
  }

  function resetInterval() {
    clearInterval(slideInterval);
    slideInterval = setInterval(nextSlide, slideDuration);
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Start carousel only if elements exist
    if (document.querySelector('.kult-carousel-slide')) {
      slideInterval = setInterval(nextSlide, slideDuration);
    }

    // Abrir modal de newsletter ao clicar em "JOIN THE KULT"
    const kultButtons = document.querySelectorAll('.kult-btn');
    const newsletterModal = document.querySelector('#newsletter-modal');
    
    if (kultButtons.length > 0 && newsletterModal) {
      kultButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault(); // Previne navegação para /products
          try {
            if (newsletterModal && typeof newsletterModal.showDialog === 'function') {
              newsletterModal.showDialog();
            }
          } catch (err) {
            console.warn('Erro ao abrir modal de newsletter:', err);
          }
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Kult Page",
  "settings": [],
  "blocks": [
    {
      "type": "carousel_image",
      "name": "Carousel Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kult Page"
    }
  ]
}
{% endschema %}
